# Docker infrastructure. Copy this file to .env and replace every password.
POSTGRES_DB=mentor_ia
POSTGRES_USER=mentor_ia
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432

RABBITMQ_USER=mentor_ia
RABBITMQ_PASSWORD=replace-with-a-strong-rabbitmq-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Application configuration for running the API locally.
DATABASE_URL="postgresql://mentor_ia:replace-with-a-strong-local-password@localhost:5432/mentor_ia?schema=public"
NODE_ENV=development
API_PREFIX="api/v1"
API_DOCS_PATH="api/docs"
CORS_ORIGINS="http://localhost:3000"
SWAGGER_ENABLED=true
JWT_SECRET="replace-with-a-secret-of-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-another-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"
PASSWORD_RESET_TTL_MINUTES=30
RABBITMQ_URL="amqp://mentor_ia:replace-with-a-strong-rabbitmq-password@localhost:5672"
RABBITMQ_EXCHANGE="mentor.events"
RABBITMQ_INSIGHTS_QUEUE="insights_queue"
PORT=3333
INSIGHT_ACTIVE_JOB_LIMIT=1
# Enable only with RabbitMQ and an OpenAI-compatible chat completions endpoint.
INSIGHT_PROCESSING_ENABLED=false
INSIGHT_AI_URL=""
INSIGHT_AI_MODEL=""
INSIGHT_AI_API_KEY=""

# URLs used only by the API container in Docker Compose.
DATABASE_URL_DOCKER="postgresql://mentor_ia:replace-with-a-strong-local-password@postgres:5432/mentor_ia?schema=public"
RABBITMQ_URL_DOCKER="amqp://mentor_ia:replace-with-a-strong-rabbitmq-password@rabbitmq:5672"
