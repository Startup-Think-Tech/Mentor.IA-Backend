# COPIE ESTAS VARIAVEIS PARA "Environment Variables" DO COOLIFY
# Substitua todos os placeholders; nao publique credenciais reais no Git.

# API
NODE_ENV=production
PORT=3333
API_PREFIX=api/v1
API_DOCS_PATH=api/docs
SWAGGER_ENABLED=true
CORS_ORIGINS=https://app.seudominio.com

# Banco de dados PostgreSQL (host acessivel de dentro do container)
DATABASE_URL=postgresql://USUARIO:SENHA_CODIFICADA@HOST_DO_POSTGRES:5432/mentor_ia?schema=public

# Autenticacao (use DOIS segredos aleatorios e diferentes, >= 32 caracteres)
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES
JWT_REFRESH_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_TTL_MINUTES=30

# RabbitMQ (host acessivel de dentro do container)
RABBITMQ_URL=amqp://USUARIO:SENHA_CODIFICADA@HOST_DO_RABBITMQ:5672
RABBITMQ_EXCHANGE=mentor.events
RABBITMQ_INSIGHTS_QUEUE=insights_queue

# Insights: ative somente quando RabbitMQ e IA estiverem configurados
INSIGHT_ACTIVE_JOB_LIMIT=1
INSIGHT_PROCESSING_ENABLED=false
INSIGHT_AI_URL=
INSIGHT_AI_MODEL=
INSIGHT_AI_API_KEY=

# Se sua senha de DB/RabbitMQ possuir @, :, /, # etc.,
# codifique esses caracteres em percent-encoding dentro das URLs.
# Nao use localhost para outros containers.
# PostgreSQL e RabbitMQ sao servicos separados da aplicacao no Coolify.
